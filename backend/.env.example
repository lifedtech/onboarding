# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/lifed_healthmate"

# ─── Authentication ───────────────────────────────────────────────────────────
# A long, random string used to sign JWT tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key_replace_this"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
# Set only if this API runs behind a reverse proxy / load balancer, so
# per-IP rate limiting sees the real client IP instead of the proxy's.
# e.g. "1" (trust one hop) — see server.js. Leave unset otherwise.
# TRUST_PROXY=1

# ─── Redis (required for message queue) ──────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Database Seeding (optional, dev only) ────────────────────────────────────
# Password assigned to the demo Ops accounts created by `prisma/seed.js`.
# Leave unset to have the seed script generate and print a random one instead.
# SEED_DEFAULT_PASSWORD="change-me-locally"

# ─── R&D Webhooks & API Keys ──────────────────────────────────────────────────
# Shared secret for verifying signatures on incoming webhooks from R&D
RD_WEBHOOK_SECRET="your_shared_webhook_secret_key_here"

# SendGrid Configuration
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="support@lifedhealth.com"

# Twilio Configuration (WhatsApp)
TWILIO_ACCOUNT_SID="AC_your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# ─── Rate limiting (all optional — sane defaults in src/config/rateLimit.config.js) ─
# Auth routes (login, and signup/password-reset if added later): per-IP and
# per-account failure counters, each with its own exponential backoff instead
# of a hard lockout. "Free attempts" pass through untouched; every failure
# after that pushes the next allowed attempt out by base * factor^n, capped
# at max, then the counter clears after `window` of inactivity (or on a
# successful attempt, for the account counter).
RATE_LIMIT_AUTH_IP_FREE_ATTEMPTS=10
RATE_LIMIT_AUTH_IP_BACKOFF_BASE_MS=1000
RATE_LIMIT_AUTH_IP_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_IP_BACKOFF_MAX_MS=900000
RATE_LIMIT_AUTH_IP_WINDOW_MS=3600000
RATE_LIMIT_AUTH_ACCOUNT_FREE_ATTEMPTS=5
RATE_LIMIT_AUTH_ACCOUNT_BACKOFF_BASE_MS=2000
RATE_LIMIT_AUTH_ACCOUNT_BACKOFF_FACTOR=2
RATE_LIMIT_AUTH_ACCOUNT_BACKOFF_MAX_MS=1800000
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_MS=3600000
# Response status codes (comma-separated) that count as a failed auth attempt
RATE_LIMIT_AUTH_FAILURE_CODES="401,403"

# Baseline for authenticated user actions (looser; keyed per logged-in user)
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=500

# Costly authenticated actions — messaging, uploads (stricter)
RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
RATE_LIMIT_SENSITIVE_MAX=30

# Public endpoints — signed webhooks etc. (moderate; keyed per-IP)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
