# Used by docker-compose.yml. Copy this file to `.env` in the repo root
# and fill in real values — never commit the resulting .env file.

# Postgres password shared by the db and backend services
POSTGRES_PASSWORD=change_me

# Must match backend/.env's JWT_SECRET philosophy: a long, random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me
